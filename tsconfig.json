{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "src",
    "paths": {
      "@gyng/ditherer-filters": ["../packages/ditherer-filters/src/index.ts"],
      "@gyng/ditherer-filters/client": ["../packages/ditherer-filters/src/client.ts"],
      "@gyng/ditherer-filters/catalog": ["../packages/ditherer-filters/src/catalog.ts"],
      "@gyng/ditherer-filters/lazy": ["../packages/ditherer-filters/src/lazy.ts"],
      "@gyng/ditherer-filters/filters/*": ["../packages/ditherer-filters/src/filters/*"],
      "@gyng/ditherer-filters/worker": ["../packages/ditherer-filters/src/worker.ts"],
      "@gyng/ditherer-filters/wasm-bindings": ["../packages/ditherer-filters/src/wasm-bindings.ts"],
      "@src/*": ["./*"],
      "actions/*": ["actions/*"],
      "components/*": ["components/*"],
      "containers/*": ["containers/*"],
      "context/*": ["context/*"],
      "reducers/*": ["reducers/*"],
      "styles/*": ["styles/*"],
      "types/*": ["types/*"],
      "utils/*": ["utils/*"]
    }
  },
  "include": ["src", "packages/ditherer-filters/src"]
}
