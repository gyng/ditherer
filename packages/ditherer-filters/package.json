{
  "name": "@gyng/ditherer-filters",
  "version": "0.6.0",
  "description": "Ditherer's browser-native Canvas2D, WebGL2, and WASM image filter engine",
  "homepage": "https://github.com/gyng/ditherer/tree/master/packages/ditherer-filters#readme",
  "bugs": {
    "url": "https://github.com/gyng/ditherer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyng/ditherer.git",
    "directory": "packages/ditherer-filters"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./dist/client.js"
    },
    "./catalog": {
      "types": "./types/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./lazy": {
      "types": "./types/lazy.d.ts",
      "import": "./dist/lazy.js"
    },
    "./filters/*": {
      "types": "./types/filters/*.d.ts",
      "import": "./dist/filters/*.js"
    },
    "./wasm-bindings": {
      "types": "./types/wasm-bindings.d.ts",
      "import": "./dist/wasm-bindings.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "node scripts/generate-selective-entries.mjs",
    "generate:check": "node scripts/generate-selective-entries.mjs --check",
    "build": "npm run generate && vite build --config vite.config.ts && npm run build:types",
    "build:types": "node scripts/clean-types.mjs && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
